# === Base de datos ===
# Local (docker compose): el host es "localhost" y el puerto 5433 (ver docker-compose.yml).
DATABASE_URL="postgresql://gopic:gopic@localhost:5433/gopic?schema=public"

# En Railway: pega la "DATABASE_URL" que Railway genera para el servicio Postgres.
# (Railway la inyecta como variable de entorno; no la subas al repo.)

# === Servidor ===
PORT=4000
NODE_ENV=development

# === CORS ===
# URL del frontend (Vercel) autorizada a consumir la API. Coma-separadas si son varias.
CORS_ORIGIN="http://localhost:5173"

# === Auth (JWT) ===
# Cámbialo por un valor largo y aleatorio en producción (Railway).
JWT_SECRET="dev-secret-cambia-esto-en-produccion"
JWT_EXPIRES="8h"
