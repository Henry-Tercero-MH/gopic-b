  productoId  String?    @map("producto_id") @db.Uuid
  producto    Producto?  @relation(fields: [productoId], references: [id])
  categoriaId String?    @map("categoria_id") @db.Uuid
  categoria   Categoria? @relation(fields: [categoriaId], references: [id])

  @@map("promocion_objetivo")
}

model ComboComponente {
  id          String    @id @default(uuid()) @db.Uuid
  promocionId String    @map("promocion_id") @db.Uuid
  promocion   Promocion @relation(fields: [promocionId], references: [id], onDelete: Cascade)
  productoId  String    @map("producto_id") @db.Uuid
  producto    Producto  @relation(fields: [productoId], references: [id], onDelete: Restrict)
  cantidad    Int       @db.SmallInt

  @@map("combo_componente")
}

model PromocionAplicacion {
  id                String    @id @default(uuid()) @db.Uuid
  promocionId       String    @map("promocion_id") @db.Uuid
  promocion         Promocion @relation(fields: [promocionId], references: [id], onDelete: Restrict)
  facturaId         String    @map("factura_id") @db.Uuid
  factura           Factura   @relation(fields: [facturaId], references: [id], onDelete: Cascade)
  descuentoAplicado Decimal   @map("descuento_aplicado") @db.Decimal(12, 4)

  @@map("promocion_aplicacion")
}

// ─────────────────────────────── Caja ───────────────────────────────
model Caja {
  id         String    @id @default(uuid()) @db.Uuid
  sucursalId String    @map("sucursal_id") @db.Uuid
  sucursal   Sucursal  @relation(fields: [sucursalId], references: [id])
  nombre     String    @db.VarChar(40)
  activa     Boolean   @default(true)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt  DateTime? @map("deleted_at") @db.Timestamptz(6)

  sesiones CajaSesion[]

  @@map("caja")
}

model CajaSesion {
  id               String           @id @default(uuid()) @db.Uuid
  sucursalId       String           @map("sucursal_id") @db.Uuid
  sucursal         Sucursal         @relation(fields: [sucursalId], references: [id])
  cajaId           String?          @map("caja_id") @db.Uuid
  caja             Caja?            @relation(fields: [cajaId], references: [id])
  usuarioId        String           @map("usuario_id") @db.Uuid
  usuario          Usuario          @relation(fields: [usuarioId], references: [id])
  fondoApertura    Decimal          @map("fondo_apertura") @db.Decimal(12, 4)
  efectivoEsperado Decimal?         @map("efectivo_esperado") @db.Decimal(12, 4)
  efectivoContado  Decimal?         @map("efectivo_contado") @db.Decimal(12, 4)
  estado           EstadoCajaSesion @default(abierta)
  abiertaEn        DateTime         @default(now()) @map("abierta_en") @db.Timestamptz(6)
  cerradaEn        DateTime?        @map("cerrada_en") @db.Timestamptz(6)
  createdAt        DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)

  movimientos CajaMovimiento[]
  facturas    Factura[]

  @@map("caja_sesion")
}

model CajaMovimiento {
  id           String      @id @default(uuid()) @db.Uuid
  cajaSesionId String      @map("caja_sesion_id") @db.Uuid
  cajaSesion   CajaSesion  @relation(fields: [cajaSesionId], references: [id], onDelete: Cascade)
  tipo         TipoCajaMov
  concepto     String      @db.VarChar(120)
  monto        Decimal     @db.Decimal(12, 4)
  registradoEn DateTime    @default(now()) @map("registrado_en") @db.Timestamptz(6)

  @@map("caja_movimiento")
}

// ─────────────────────────── Clientes y fidelización ───────────────────────────
model Cliente {
  id         String    @id @default(uuid()) @db.Uuid
  sucursalId String    @map("sucursal_id") @db.Uuid
  sucursal   Sucursal  @relation(fields: [sucursalId], references: [id])
  nombre     String    @db.VarChar(120)
  nit        String?   @db.VarChar(20)
  telefono   String?   @db.VarChar(30)
  email      String?   @db.VarChar(160)
  puntos     Int       @default(0)
  visitas    Int       @default(0)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt  DateTime? @map("deleted_at") @db.Timestamptz(6)

  cuentas        Cuenta[]
  facturas       Factura[]
  movimientosLtd MovimientoLealtad[]
  reservaciones  Reservacion[]

  @@map("cliente")
}

model ConfigLealtad {
  id                String   @id @default(uuid()) @db.Uuid
  sucursalId        String   @unique @map("sucursal_id") @db.Uuid
  sucursal          Sucursal @relation(fields: [sucursalId], references: [id])
  quetzalesPorPunto Decimal  @map("quetzales_por_punto") @db.Decimal(12, 4)
  activo            Boolean  @default(true)
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("config_lealtad")
}

model Recompensa {
  id          String         @id @default(uuid()) @db.Uuid
  sucursalId  String         @map("sucursal_id") @db.Uuid
  sucursal    Sucursal       @relation(fields: [sucursalId], references: [id])
  nombre      String         @db.VarChar(120)
  tipo        TipoRecompensa
  costoPuntos Int            @map("costo_puntos")
  productoId  String?        @map("producto_id") @db.Uuid
  producto    Producto?      @relation(fields: [productoId], references: [id])
  valor       Decimal?       @db.Decimal(12, 4)
  activa      Boolean        @default(true)
  createdAt   DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt   DateTime?      @map("deleted_at") @db.Timestamptz(6)

  movimientosLtd MovimientoLealtad[]

  @@map("recompensa")
}

model MovimientoLealtad {
  id           String         @id @default(uuid()) @db.Uuid
  clienteId    String         @map("cliente_id") @db.Uuid
  cliente      Cliente        @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  facturaId    String?        @map("factura_id") @db.Uuid
  factura      Factura?       @relation(fields: [facturaId], references: [id])
  recompensaId String?        @map("recompensa_id") @db.Uuid
  recompensa   Recompensa?    @relation(fields: [recompensaId], references: [id])
  tipo         TipoMovLealtad
  puntos       Int
  descripcion  String         @db.VarChar(120)
  createdAt    DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([clienteId, createdAt])
  @@map("movimiento_lealtad")
}

// ─────────────────────────────── Gastos ───────────────────────────────
model CategoriaGasto {
  id        String   @id @default(uuid()) @db.Uuid
  nombre    String   @unique @db.VarChar(60)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  gastos Gasto[]

  @@map("categoria_gasto")
}

model Gasto {
  id               String         @id @default(uuid()) @db.Uuid
  sucursalId       String         @map("sucursal_id") @db.Uuid
  sucursal         Sucursal       @relation(fields: [sucursalId], references: [id])
  categoriaGastoId String         @map("categoria_gasto_id") @db.Uuid
  categoriaGasto   CategoriaGasto @relation(fields: [categoriaGastoId], references: [id], onDelete: Restrict)
  proveedorId      String?        @map("proveedor_id") @db.Uuid
  proveedor        Proveedor?     @relation(fields: [proveedorId], references: [id])
  usuarioId        String         @map("usuario_id") @db.Uuid
  usuario          Usuario        @relation(fields: [usuarioId], references: [id])
  concepto         String         @db.VarChar(160)
  monto            Decimal        @db.Decimal(12, 4)
  metodo           MetodoGasto
  estado           EstadoGasto    @default(pendiente)
  fecha            DateTime       @default(now()) @db.Date
  createdAt        DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("gasto")
}

// ─────────────────────────────── Secuencias ───────────────────────────────
